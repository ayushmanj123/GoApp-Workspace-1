# =============================================================================
# GoApps Platform â€” Root Environment Template
# Copy to .env and adjust values for local development.
# Never commit real secrets or tenant IDs to source control.
# =============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=goapps
POSTGRES_PASSWORD=changeme
POSTGRES_DB=goapps
DATABASE_URL=postgres://goapps:changeme@localhost:5432/goapps?sslmode=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=goapps-artifacts
MINIO_USE_SSL=false
# Bucket used by metadata-service to store publish artifacts (application
# snapshot blobs uploaded on publish; see Phase 8.1). Auto-created if missing.
MINIO_PUBLISH_BUCKET=goapps-publish

# --- Keycloak (Auth) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=goapps
KEYCLOAK_CLIENT_ID=goapps-platform
KEYCLOAK_CLIENT_SECRET=changeme

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Backend Service Ports ---
AUTH_SERVICE_PORT=8081
METADATA_SERVICE_PORT=8082
RUNTIME_SERVICE_PORT=8083
CONNECTOR_SERVICE_PORT=8084
PUBLISH_SERVICE_PORT=8085
ENVIRONMENT_SERVICE_PORT=8086
AUDIT_SERVICE_PORT=8087
SEARCH_SERVICE_PORT=8088

# --- Frontend ---
VITE_API_BASE_URL=/api/v1

# --- Connector secrets (AES-GCM; set same value on metadata + runtime) ---
# SECRETS_MASTER_KEY=

# --- Google Sheets / Excel Apps (metadata-service OAuth) ---
# Enable Sheets API + Drive API in Google Cloud; register the redirect URI on the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_CONNECTOR_REDIRECT_URI=http://localhost:8082/api/v1/connectors/oauth/callback
