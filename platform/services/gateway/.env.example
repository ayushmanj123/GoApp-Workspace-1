SERVICE_NAME=gateway-service
PORT=8090
APP_ENV=development
LOG_LEVEL=debug

AUTH_MODE=development
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=goapps
KEYCLOAK_CLIENT_ID=goapps-platform
KEYCLOAK_AUDIENCE=goapps-platform

AUTH_DEV_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
AUTH_DEV_DEFAULT_EMAIL=admin@development.local
AUTH_DEV_DEFAULT_ROLES=PlatformAdmin

METADATA_SERVICE_URL=http://localhost:8082
PUBLISH_SERVICE_URL=http://localhost:8085
